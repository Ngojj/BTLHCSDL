NODE_ENV=development
PORT=4000
# Use a long random value in production (>= 32 chars), e.g. `openssl rand -hex 32`
TOKEN_SECRET=replace_with_strong_random_secret

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=replace_with_db_password
DATABASE=elearning_db
# true for managed MySQL that requires TLS (Aiven, PlanetScale, ...)
DATABASE_SSL=false
# true = apply pending migrations/*.sql when the server starts
RUN_MIGRATIONS=false

# Comma-separated. Supports wildcards for preview deployments, e.g.
# CORS_ORIGIN=http://localhost:3000,https://*.vercel.app
CORS_ORIGIN=http://localhost:3000
# Public URL of the frontend. PayOS sends the customer back here after paying, and the QR code on
# every certificate PDF points to <FRONTEND_URL>/verify/<code> - set it to the real domain in production.
FRONTEND_URL=http://localhost:3000

GOOGLE_CLIENT_ID=

# PayOS (https://payos.vn). The webhook URL to register is  <backend>/payment/webhook
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
